# Economic Intelligence Platform - Environment Configuration
# Phase A Testing Configuration

# ===========================================
# Kafka Configuration
# ===========================================
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_BOOTSTRAP_SERVERS_EXTERNAL=localhost:9092
KAFKA_REPLICATION_FACTOR=1
KAFKA_PARTITIONS=3
KAFKA_RETENTION_MS=604800000  # 7 days

# ===========================================
# MinIO Configuration
# ===========================================
MINIO_ENDPOINT=minio:9000
MINIO_ENDPOINT_EXTERNAL=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_SECURE=false
MINIO_REGION=us-east-1

# MinIO Buckets
MINIO_BRONZE_BUCKET=bronze
MINIO_SILVER_BUCKET=silver
MINIO_GOLD_BUCKET=gold

# ===========================================
# Data Producer Configuration
# ===========================================
LOG_LEVEL=INFO
EXTRACTION_BATCH_SIZE=100  # Reduced for testing
API_TIMEOUT=30
RETRY_ATTEMPTS=3
RETRY_DELAY=1000  # milliseconds

# ===========================================
# Government API Configuration
# ===========================================

# ACRA API Configuration
ACRA_API_URL=https://data.gov.sg/api/action/datastore_search
ACRA_RESOURCE_ID=d_3f960c10fed6145404ca7b821f263b87

# SingStat API Configuration
SINGSTAT_API_URL=https://data.gov.sg/api/action/datastore_search
SINGSTAT_RESOURCE_DISCOVERY_URL=https://api-open.data.gov.sg/v1/public/api/resourceid

# URA API Configuration
URA_API_URL=https://eservice.ura.gov.sg/uraDataService/invokeUraDS/v1
URA_TOKEN_URL=https://eservice.ura.gov.sg/uraDataService/insertNewToken/v1
URA_ACCESS_KEY=99e4b0fe-aae4-4605-94b2-d480e69b8c65

# ===========================================
# Kafka Topics Configuration
# ===========================================
ACRA_TOPIC=acra-companies
SINGSTAT_TOPIC=singstat-economics
URA_TOPIC=ura-geospatial

# ===========================================
# Development Configuration
# ===========================================
DEVELOPMENT_MODE=true
DEBUG_LOGGING=true
TEST_MODE=true

# ===========================================
# Performance Tuning
# ===========================================
# Kafka Producer Settings
KAFKA_BATCH_SIZE=16384
KAFKA_LINGER_MS=5
KAFKA_BUFFER_MEMORY=33554432
KAFKA_COMPRESSION_TYPE=snappy
KAFKA_ACKS=all
KAFKA_RETRIES=3
KAFKA_MAX_IN_FLIGHT_REQUESTS=1

# Connection Pool Settings
HTTP_POOL_CONNECTIONS=10
HTTP_POOL_MAXSIZE=20
HTTP_MAX_RETRIES=3